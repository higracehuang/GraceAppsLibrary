    "Sign in to iCloud in Settings on your iPhone and Apple Watch to sync." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Melde dich zum Synchronisieren auf deinem iPhone und deiner Apple Watch in den Einstellungen bei iCloud an." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign in to iCloud in Settings on your iPhone and Apple Watch to sync." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Inicia sesión en iCloud en Ajustes de tu iPhone y Apple Watch para sincronizar." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connectez-vous à iCloud dans Réglages sur votre iPhone et votre Apple Watch pour synchroniser." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "同期するには、iPhoneとApple Watchの「設定」でiCloudにサインインしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "동기화하려면 iPhone 및 Apple Watch의 설정에서 iCloud에 로그인하세요." } },
