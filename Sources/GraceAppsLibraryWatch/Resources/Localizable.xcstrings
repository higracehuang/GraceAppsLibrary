    "Upgrade to Pro on your iPhone to unlock the Watch app." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Führe auf deinem iPhone ein Upgrade auf Pro durch, um die Watch-App freizuschalten." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Upgrade to Pro on your iPhone to unlock the Watch app." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Actualiza a Pro en tu iPhone para desbloquear la app del Watch." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Passez à Pro sur votre iPhone pour débloquer l’app Watch." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Watchアプリを利用するには、iPhoneでProにアップグレードしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Watch 앱을 잠금 해제하려면 iPhone에서 Pro로 업그레이드하세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 iPhone 上升级到 Pro 版以解锁 Watch 应用。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在 iPhone 上升級至 Pro 版以解鎖 Watch App。" } }
